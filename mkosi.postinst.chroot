#!/bin/bash
set -euo pipefail

install -d -m 0711 /var/lib/confer

useradd \
  --system \
  --user-group \
  --home-dir /var/lib/confer/workspace \
  --shell /bin/bash \
  --password '*' \
  confer-job

/usr/bin/python3 -m pip install \
  --break-system-packages \
  --no-deps \
  --only-binary=:all: \
  --require-hashes \
    --requirement /usr/local/share/confer/document-core-requirements.txt

install -d -m 0755 /usr/lib/confer-document-worker
tar -C "$SRCDIR/document-worker" --exclude=__pycache__ -cf - src \
  | tar -C /usr/lib/confer-document-worker --no-same-owner -xf -
/usr/bin/python3 -m pip install \
  --no-compile \
  --no-deps \
  --only-binary=:all: \
  --require-hashes \
  --target /usr/lib/confer-document-worker/runtime \
    --requirement "$SRCDIR/document-worker/requirements-runtime.txt"
PYTHONDONTWRITEBYTECODE=1 \
PYTHONPATH=/usr/lib/confer-document-worker/runtime:/usr/lib/confer-document-worker/src \
  /usr/bin/python3 -S -m confer_document_worker.main --check

systemctl enable systemd-networkd.service
systemctl enable systemd-networkd-wait-online.service
systemctl enable systemd-timesyncd.service
systemctl enable nftables.service
systemctl enable confer-worker-config.service
systemctl enable confer-worker.service
systemctl enable confer-worker-health.socket
systemctl enable confer-document-worker.socket
systemctl mask ssh.service ssh.socket

truncate --size 0 /etc/machine-id
rm -f /var/lib/dbus/machine-id
ln -s /etc/machine-id /var/lib/dbus/machine-id
