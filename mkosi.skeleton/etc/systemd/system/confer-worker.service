[Unit]
Description=Confer single-use reservable confidential SSH worker
RefuseManualStart=yes
After=network-online.target nftables.service confer-worker-config.service sys-kernel-config.mount
Wants=network-online.target
Requires=nftables.service confer-worker-config.service sys-kernel-config.mount

[Service]
Type=simple
User=root
Group=root
RuntimeDirectory=sshd
RuntimeDirectoryMode=0755
ExecStartPre=/usr/bin/chown root:root /sys/kernel/config/tsm/report
ExecStartPre=/usr/bin/chmod 0700 /sys/kernel/config/tsm/report
ExecStartPre=/usr/bin/python3 -m venv --system-site-packages /var/lib/confer/workspace/.venv
ExecStartPre=/usr/bin/chown -R confer-job:confer-job /var/lib/confer/workspace/.venv
ExecStart=/usr/local/libexec/confer-worker-listener
ExecStopPost=-/bin/rm -f /run/confer/ready
Restart=no
TimeoutStopSec=10s
KillMode=control-group
StandardError=journal+console

NoNewPrivileges=yes
CapabilityBoundingSet=CAP_AUDIT_WRITE CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_NET_BIND_SERVICE CAP_SETGID CAP_SETUID CAP_SYS_CHROOT
AmbientCapabilities=CAP_SETUID
DevicePolicy=closed
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
RemoveIPC=yes
ReadWritePaths=/run/confer /var/lib/confer/workspace /sys/kernel/config/tsm/report
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
TasksMax=infinity
UMask=0077

[Install]
WantedBy=multi-user.target
